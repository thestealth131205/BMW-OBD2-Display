CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_PERF_MONITOR=n

# BMW-Multi-Ansicht: grosse Geschwindigkeitsanzeige (montserrat 48),
# vergroesserte Gaspedal-/Drehzahl-Felder (montserrat 28)
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# QR-Code auf dem WLAN-Update-Screen (WIFI:-URI zum direkten Verbinden ohne
# manuelle SSID/Passwort-Eingabe).
CONFIG_LV_USE_QRCODE=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Verdacht auf Stack-Ueberlauf im Bluedroid-BTC-Task (dort laeuft unser
# GATTC-Callback inkl. SD-Logging bei jeder BLE-Notify) - vermutlicher
# Grund fuer sporadische reset_reason=4/7-Boot-Loops waehrend BLE-OBD-
# Verbindungsaufbau/-betrieb. Default-Stacks (BTC 3072, BTU 4096) auf
# Verdacht vergroessert, mangels Crash-Dump nicht bestaetigt.
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=6144

# Crash-Dump auf Flash (eigene "coredump"-Partition in partitions.csv) statt
# nur UART-Ausgabe - die Abstuerze passieren beim Fahren, ohne angeschlossenen
# Rechner/Monitor sahen wir bisher nie den echten Panic-Grund/Backtrace. Wird
# jetzt beim naechsten Boot automatisch ausgelesen und ins SD-Log geschrieben
# (main.c: log_and_clear_coredump()).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# CONFIG_LCD_RGB_ISR_IRAM_SAFE / CONFIG_GDMA_ISR_IRAM_SAFE wurden in v1.0.9
# versuchsweise gegen ein verzerrtes Bild ergaenzt, haben aber den Framebuffer-
# in-PSRAM-Aufbau (fb_in_psram=true in ST7701S.c, kein Bounce-Buffer) komplett
# unbrauchbar gemacht - Display blieb dauerhaft schwarz. In v1.0.10 wieder
# entfernt.

# Bildverzerrung (vertauschte/verschobene Multi-Kachel-Felder nach der
# Startanimation) ist KEIN Logikfehler in bmw_ui.c, sondern das bekannte
# Tearing der RGB-Panel-Doppel-Framebuffer-Betriebsart (siehe Kommentar-
# Historie in der Git-Log dieser Datei). Der Versuch, stattdessen auf
# Single-Framebuffer + Bounce-Buffer + Vsync-Semaphor umzustellen
# (v1.0.11/v1.0.12), hat zwar kompiliert, das Display blieb am Fahrzeug aber
# dauerhaft schwarz - ohne angeschlossene Seriellkonsole laesst sich nicht
# sagen, ob das ein Haenger im Vsync-Warten (example_lvgl_flush_cb wartet mit
# portMAX_DELAY auf sem_vsync_end) oder ein Absturz in esp_lcd_new_rgb_panel()
# selbst war. Nachdem diese RGB-Timing-Umstellung jetzt zweimal
# (v1.0.9 und v1.0.11/12) zu einem schwarzen Display gefuehrt hat, zurueck auf
# die zuletzt bestaetigt funktionierende Konfiguration (Doppel-Framebuffer,
# full_refresh, Tearing vorhanden aber Display geht an). Das Tearing-Problem
# bleibt ungeloest, muss aber mit echter Diagnose (serielle Konsole, GPIO43/44
# sind bei BLE-OBD-Betrieb frei) angegangen werden statt mit weiteren
# Kconfig-Versuchen auf Verdacht.
CONFIG_EXAMPLE_DOUBLE_FB=y
CONFIG_EXAMPLE_USE_BOUNCE_BUFFER=n
CONFIG_EXAMPLE_AVOID_TEAR_EFFECT_WITH_SEM=n

# Die AP-Zugangsdaten fuer das WLAN-Update (OTA_WEB_SSID/OTA_WEB_PASS in
# ota_web.c) sind fest im Code hinterlegt, nicht vom Nutzer eingegeben. Der
# WiFi-Treiber versucht trotzdem per Default, jede esp_wifi_set_config()-
# Aenderung in die "nvs"-Partition zu schreiben und beim naechsten Start
# wieder von dort zu lesen (wifi_init_config_t.nvs_enable, ueber
# WIFI_INIT_CONFIG_DEFAULT() gesetzt). Laut Waveshares eigenem Hinweis fuehrt
# das bei hartkodierten Zugangsdaten zu Warnungen/Fehlern - da hier ohnehin
# nie eine gespeicherte Config gebraucht wird (Umschalten STA<->AP passiert
# nur zur Laufzeit in ota_web.c), schaltet dieser Schalter die NVS-Nutzung
# des WiFi-Treibers komplett ab.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# "Hotspot verbinden" (SNTP) scheiterte mit "zu wenig Speicher" an
# xTaskCreatePinnedToCore() fuer den neuen 6-KB-Task-Stack, obwohl die SD-Karte
# laut Nutzer bereits FAT32/32GB war - also kein SD-Problem. Ursache: Task-
# Stacks verlangen per Default internes DRAM, das sich Bluedroid (aktive
# BLE-OBD-Verbindung) + WiFi-Puffer + LVGL bereits teilen (~300KB knapp),
# waehrend die 8MB PSRAM (fuer die Framebuffer) reichlich frei sind. Offiziell
# unterstuetzte ESP-IDF-Option, die Task-Stacks bei Bedarf aus PSRAM erlaubt -
# entlastet nicht nur SNTP, sondern jede kuenftige xTaskCreate-Allokation
# (z. B. den SD-Format-Task).
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
