CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_PERF_MONITOR=y

# BMW-Multi-Ansicht: grosse Geschwindigkeitsanzeige (montserrat 48),
# vergroesserte Gaspedal-/Drehzahl-Felder (montserrat 28)
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_28=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Verdacht auf Stack-Ueberlauf im Bluedroid-BTC-Task (dort laeuft unser
# GATTC-Callback inkl. SD-Logging bei jeder BLE-Notify) - vermutlicher
# Grund fuer sporadische reset_reason=4/7-Boot-Loops waehrend BLE-OBD-
# Verbindungsaufbau/-betrieb. Default-Stacks (BTC 3072, BTU 4096) auf
# Verdacht vergroessert, mangels Crash-Dump nicht bestaetigt.
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=6144

# Crash-Dump auf Flash (eigene "coredump"-Partition in partitions.csv) statt
# nur UART-Ausgabe - die Abstuerze passieren beim Fahren, ohne angeschlossenen
# Rechner/Monitor sahen wir bisher nie den echten Panic-Grund/Backtrace. Wird
# jetzt beim naechsten Boot automatisch ausgelesen und ins SD-Log geschrieben
# (main.c: log_and_clear_coredump()).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# CONFIG_LCD_RGB_ISR_IRAM_SAFE / CONFIG_GDMA_ISR_IRAM_SAFE wurden in v1.0.9
# versuchsweise gegen ein verzerrtes Bild ergaenzt, haben aber den Framebuffer-
# in-PSRAM-Aufbau (fb_in_psram=true in ST7701S.c, kein Bounce-Buffer) komplett
# unbrauchbar gemacht - Display blieb dauerhaft schwarz. In v1.0.10 wieder
# entfernt.

# Bildverzerrung (vertauschte/verschobene Multi-Kachel-Felder nach der
# Startanimation) ist KEIN Logikfehler in bmw_ui.c, sondern das bekannte
# Tearing der RGB-Panel-Doppel-Framebuffer-Betriebsart: Der Waveshare-
# Beispielcode (main/Kconfig.projbuild) setzt standardmaessig
# EXAMPLE_DOUBLE_FB=y - zwei volle 480x480-Framebuffer direkt in PSRAM,
# LVGL zeichnet mit full_refresh=true komplett in den jeweils anderen Puffer,
# ohne dass ein Vsync-Semaphor das Scannen der RGB-DMA mit dem Fertigwerden
# des Zeichnens synchronisiert (CONFIG_EXAMPLE_AVOID_TEAR_EFFECT_WITH_SEM
# haengt an "depends on !EXAMPLE_DOUBLE_FB" und war nie aktiv). Dieser Zustand
# bestand schon vor v1.0.7 unveraendert, v1.0.7 hat nur Logging/Coredump
# geaendert, keinen Display-Code.
# Fix: zurueck auf die vom esp_lcd-RGB-Treiber vorgesehene Tearing-freie
# Betriebsart - ein Framebuffer in PSRAM + kleiner interner Bounce-Buffer
# (DMA liest nur aus dem Bounce-Buffer, nie direkt aus PSRAM) + Vsync-Semaphor-
# Sync (Code dafuer existiert bereits in ST7701S.c/LVGL_Driver.c, war nur per
# Kconfig deaktiviert). Anders als der v1.0.9-Versuch oben wird hier zusaetzlich
# auch tatsaechlich auf Single-Framebuffer+Bounce-Buffer umgeschaltet, nicht
# nur die IRAM-Safe-Flags auf der (dafuer nicht vorgesehenen) Doppel-FB-PSRAM-
# Variante draufgesetzt - das war die eigentliche invalide Kombination, die in
# v1.0.9 zum Schwarzbild fuehrte.
CONFIG_EXAMPLE_DOUBLE_FB=n
CONFIG_EXAMPLE_USE_BOUNCE_BUFFER=y
CONFIG_EXAMPLE_AVOID_TEAR_EFFECT_WITH_SEM=y
